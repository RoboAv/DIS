@startuml

set theme = light
set direction = TB
set rank_sep = 22
set node_sep = 22
set font_size = 13
set font = Segoe UI
set hide_empty = on
set padding = 12
set shadow = off

shape сущность extends class {
  accent: #1565c0
}

shape связь {
  form: diamond
  accent: #6a1b9a
}

shape контроль extends class {
  accent: #b71c1c
}

сущность "Физическое лицо" as Person {
  ФИО, паспорт
  ИНН, СНИЛС, доход
  адрес и телефон
}

сущность "Юридическое лицо" as Company {
  наименование
  ИНН, ОГРН, КПП
  адрес и выручка
}

связь Ben as "бенефициар" {
  доля
  основание контроля
}

контроль "Согласие" as Consent {
  цель и основание
  срок и способ
  дата отзыва
}

сущность "Кредитная история" as History {
  бюро и дата
  балл, обязательства
  самозапрет
}

контроль "Идентификация" as Ident {
  дата и способ
  уровень риска
  статус и срок
}

сущность "Кредитный продукт" as Product {
  вид, валюта, границы
  залог и охлаждение
  срок одобрения
}

сущность "Заявка" as Application {
  номер, канал, статус
  сумма, срок, цель
  статус хранения
}

контроль "Правило хранения" as Rule {
  категория сведений
  основание и срок
  событие начала
}

сущность "Кредитное решение" as Decision {
  результат и условия
  ПДН и способ
  причина отказа
}

контроль "Сотрудник" as Staff {
  роль
}

сущность "Кредитный договор" as Contract {
  сумма, ставка, ПСК
  счёт и подписание
  охлаждение, статус
}

контроль "Журнал доступа" as Audit {
  действие и объект
  время и основание
  срок хранения
}

связь Surety as "поручительство" {
  дата
  предел ответственности
}

сущность "Платёж" as Payment {
  плановая дата
  долг и проценты
  статус оплаты
}

сущность "Обеспечение" as Collateral {
  вид и предмет
  оценочная стоимость
}

сущность "Страховой договор" as Insurance {
  вид и страховщик
  премия и срок
  признак добровольности
}

Person ||---[right]-o{ Ben
Ben }|---[right]-|| Company

Person ||---o{ Consent : даёт
Consent |o--o{ History : разрешает

' History -[hidden,right]- Ident
Person ||--o{ Ident : проходит
Company ||--o{ Ident : проходит
Company |o----o{ History : субъект

' Product ||--o{ Application
Application }o---[right]-|| Product
Application }o--[up]-|| Rule
History }o--[right]-|| Application : используется
Person }o-[down]-o{ Application
Company |o-[down]-o{ Application : подаёт

Application ||-[down]-|{ Decision : рассматривается
' Decision -[hidden,right]- Staff
Decision ||-[down]-o| Contract : порождает
' Contract -[hidden,right]- Audit
Staff ||-[down]-o{ Audit : выполняет

Contract ||--|{ Payment : график
Contract ||--o{ Collateral : обеспечивается
Contract ||--o{ Insurance : страхуется
' Payment -[hidden,right]- Collateral
' Collateral -[hidden,right]- Insurance

Person ||-[down]-o{ Surety
Contract ||---[left]-o{ Surety

@enduml
