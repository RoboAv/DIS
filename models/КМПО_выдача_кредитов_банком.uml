@startuml
' title test

set hide_empty = on

shape relation {
  form: diamond
}

object person
object company
object credit
object personal_data
object company_data
object operations_history

relation credit_terms {
  Проценты
  Сумма
  Срок
  Кол-во выплат
}
relation benefitiar as "Бенефициар"

company "1" --> benefitiar
benefitiar --> "0..n" person

personal_data --> operations_history
person --> personal_data
person --> credit_terms
company --> credit_terms
company --> company_data
credit_terms -[right]-> credit

@enduml
