@startuml

set theme = light
set direction = TB
set rank_sep = 46
set node_sep = 108
set font_size = 13
set font = Segoe UI
set hide_empty = on
set padding = 16
set shadow = off
 set edge_style = ortho

shape сущность extends class {
  accent: #1565c0
}

shape rel {
  form: diamond
  accent: #6a1b9a
}

shape control extends class {
  accent: #b71c1c
}

сущность "Физическое лицо" as Person {
  ФИО
  паспорт
  ИНН, СНИЛС, доход
  адрес и телефон
}

сущность "Юридическое лицо" as Company {
  наименование
  ИНН, ОГРН, КПП
  адрес и выручка
}

rel Benefitiar as "Бенефициар" {
  доля
  основание контроля
}

control "Согласие" as Consent {
  цель и основание
  срок и способ
  дата отзыва
}

сущность "Кредитная история" as History {
  бюро и дата
  балл, обязательства
  самозапрет
}

control "Идентификация" as Ident {
  дата и способ
  уровень риска
  статус и срок
}

сущность "Кредитный продукт" as Product {
  вид, валюта, границы
  залог и охлаждение
  срок одобрения
}

сущность "Заявка" as Application {
  номер, канал, статус
  сумма, срок, цель
  статус хранения
}

control "Правило хранения" as Rule {
  категория сведений
  основание и срок
  событие начала
}

сущность "Кредитное решение" as Decision {
  результат
  условия
  ПДН и способ
  причина отказа
}
сущность "Кредитный договор" as Contract {
  сумма, ставка, ПСК
  счёт и подписание
  охлаждение, статус
}

rel "Поручительство" as Surety {
  дата
  предел ответственности
}

сущность "Платёж" as Payment {
  плановая дата
  долг и проценты
  статус оплаты
}

сущность "Обеспечение" as Collateral {
  вид и предмет
  оценочная стоимость
}

сущность "Страховой договор" as Insurance {
  вид и страховщик
  премия и срок
  признак добровольности
}
Consent -[hidden,right]- History
History -[hidden,right]- Application
Application -[hidden,right]- Product

Person -[hidden,right]- Benefitiar
Benefitiar -[hidden,right]- Company
Company -[hidden,right]- Decision

Consent |o-[right]-o{ History : разрешает
History }o-[right]-|| Application : используется
Application }o-[right]-|| Product

Person ||-[up]-o{ Consent : даёт
Company |o-[up]-o{ History : субъект
Person }o-[up]-o{ Application
Company |o-[up]-o{ Application : подаёт

Person ||-[right]-o{ Benefitiar
Benefitiar }|-[right]-|| Company

Person ||-[down]-o{ Ident : проходит
Company ||-[down]-o{ Ident : проходит

Application ||-[down]-|{ Decision : рассматривается
Rule ||-[up]-o{ Application
Decision -[hidden,left]- Rule
Rule -[hidden,left]-Company


Decision ||-[down]-o| Contract : порождает

Contract ||--|{ Payment : график
Contract ||--o{ Collateral : обеспечивается
Contract ||--o{ Insurance : страхуется
Contract ||--o{ Surety
Person ||-[down]-o{ Surety

Surety -[hidden,right]- Payment
Payment -[hidden,right]- Collateral
Collateral -[hidden,right]- Insurance

legend
Синий — данные предметной области
Красный — контроль обработки и хранения
Ромб — связь с собственными данными
endlegend

@enduml
