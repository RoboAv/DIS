@startuml

set theme = light
set direction = TB
set rank_sep = 88
set node_sep = 100
set font_size = 16
set font = Segoe UI
set hide_empty = on
set padding = 36
set shadow = off
set edge_style = ortho

shape сущность extends class {
  accent: #1565c0
}

shape rel {
  form: diamond
  accent: #6a1b9a
}

shape control extends class {
  accent: #b71c1c
}

сущность "Физическое лицо" as Person {
  идентификатор
  ФИО
  паспорт и дата рождения
  гражданство и адрес
}

rel Part as "Участие" {
  идентификатор
  доля
  вид связи
  основание
}

сущность "Юридическое лицо" as Company {
  идентификатор
  наименование и ОПФ
  ИНН, ОГРН и ОКВЭД
  статус, адрес, лицензия
}

rel Hold as "Владение" {
  идентификатор
  доля
  основание
}

control "Согласие" as Consent {
  идентификатор
  цель обработки
  основание
  срок действия
}

сущность "Обязательная проверка" as Check {
  идентификатор
  вид и норма
  результат проверки
  источник и дата
}

сущность "Финансовая отчётность" as Report {
  идентификатор
  форма и период
  валюта отчёта
  дата составления
}

сущность "Показатель" as Fact {
  идентификатор
  вид и период
  значение показателя
  источник и дата
}

rel Used as "Учтено" {
  идентификатор
  вес
  порог
  вывод
}

сущность "Заявка" as Request {
  идентификатор
  номер, дата и канал
  сумма, срок и валюта
  статус и цель проверки
}

сущность "Кредитные условия" as Terms {
  идентификатор
  продукт и валюта
  лимиты и срок
  требование обеспечения
}

сущность "Корпоративное одобрение" as Approval {
  идентификатор
  орган и дата решения
  вид сделки
  одобренная сумма
}

сущность "Обеспечение" as Pledge {
  идентификатор
  вид и предмет залога
  оценка стоимости
  действующее обременение
}

сущность "Заключение" as Verdict {
  идентификатор
  результат проверки
  уровень риска
  срок действия
  причина отказа
}

control "Правило хранения" as Rule {
  идентификатор
  категория сведений
  основание и срок
  событие начала отсчёта
}

' Положение блоков. Без этих строк раскладка снова автоматическая.
at Person 56, 121
at Part 356, 62.5
at Company 700, 121
at Hold 995, 88
at Rule 1300, 121
at Consent 90.5, 430
at Check 332.5, 430
at Report 685, 430
at Request 349, 700
at Fact 708, 700
at Terms 8, 700
at Used 723, 1000
at Approval 48, 1400
at Pledge 360, 1400
at Verdict 700, 1400

Person ||--o{ Part : участвует
Part }o--|| Company : в организации
Company ||--o{ Hold : владеет

' Петля владения идёт над блоками, не через соседние сущности.
Hold }o--|| Company : объект
via Hold Company #1 1089.5, 36; 797.5, 36
exit Hold Company #1 94.5, 0
entry Hold Company #1 97.5, 0

' У согласия ровно один давший: лицо либо организация.
Person |o--o{ Consent : даёт (лицо)

' Второе «даёт» обходит верхний ряд слева, чтобы не пересечь «по лицу».
Company |o--o{ Consent : даёт (организация)
via Company Consent #1 736, 24; 20, 24; 20, 499
exit Company Consent #1 36, 0
entry Company Consent #1 0, 69

Consent |o--o{ Check : допускает
Part |o--o{ Check : по лицу
Company ||--o{ Report : ведёт
Report |o--o{ Fact : содержит

Check }|--|| Request : проходит

' «Подаёт» спускается по зазору между проверкой и отчётностью.
Company ||--o{ Request : подаёт
via Company Request #1 724, 370; 623, 370; 623, 640; 500, 640
exit Company Request #1 24, 138
entry Company Request #1 151, 0
labelat Company Request #1 -90, 120

Fact ||--o{ Used : входит

' «В заявке» заходит снизу, ниже показателя, и не режет вертикаль «входит».
Used }o--|| Request : в заявке
via Used Request #1 519, 1127
exit Used Request #1 0, 127.5
entry Used Request #1 170, 138

Request }o--|| Terms : на условиях

Request ||--o{ Approval : одобрена
via Request Approval #1 385, 1320; 175, 1320
exit Request Approval #1 36, 138
entry Request Approval #1 127, 0
labelat Request Approval #1 -180, 70

Request ||--o{ Pledge : предлагает
via Request Pledge #1 427, 1360; 473.5, 1360
exit Request Pledge #1 78, 138
entry Request Pledge #1 113.5, 0
labelat Request Pledge #1 40, 230

Request ||--o{ Verdict : рассматривается
via Request Verdict #1 469, 1320; 785.5, 1320
exit Request Verdict #1 120, 138
entry Request Verdict #1 85.5, 0
labelat Request Verdict #1 140, 20

' Отложенные связи предметной области. На схему не выведены:
' Company ||--o{ Fact : относится к
' Request }o--o| Company : поручитель
' Pledge }o--o| Company : собственник
' Check }o--o| Company : по организации

legend
Синий — данные предметной области
Красный — контроль обработки и хранения
Ромб — связь с собственными данными
У каждого блока есть суррогатный идентификатор
Кодификаторы на схему не вынесены
Согласие даёт лицо либо организация: заполнен ровно один конец
Хранение «клиент» — физическое и юридическое лицо; участие и владение хранятся вместе с ними
Хранение «показатель» — показатель и финансовая отчётность
Хранение «пакет» — заявка, проверка, учтено, одобрение, обеспечение и заключение
Хранение «условия» — кредитные условия
endlegend

@enduml


