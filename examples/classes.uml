@startuml
title Диаграмма классов

abstract class Транспорт {
  # id: int
  # марка: string
  --
  + {abstract} двигаться(): void
  + описание(): string
}

class Автомобиль {
  + колёс: int = 4
  + завести(): bool
}

class Грузовик {
  + тоннаж: double
}

interface Обслуживаемый {
  + пройтиТО(дата: Date)
}

enum Состояние {
  НОВЫЙ
  В_РЕМОНТЕ
  СПИСАН
}

class Двигатель {
  + мощность: int
}

Транспорт <|-- Автомобиль
Автомобиль <|-- Грузовик
Автомобиль ..|> Обслуживаемый
Транспорт --> Состояние : состояние
Автомобиль "1" *-- "1" Двигатель : содержит
Грузовик "1" o-- "0..*" Прицеп : буксирует

class Прицеп {
  + объём: double
}
@enduml
