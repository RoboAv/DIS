@startuml
title Модель предметной области

set theme = light
set rank_sep = 72

entity Пользователь {
  + id: uuid
  + email: string
  + создан: datetime
}

entity Профиль {
  + фио: string
  + телефон: string
}

entity Заказ {
  + номер: string
  + сумма: decimal
  + статус: Статус
}

entity Позиция {
  + количество: int
  + цена: decimal
}

entity Товар {
  + артикул: string
  + название: string
}

enum Статус {
  НОВЫЙ
  ОПЛАЧЕН
  ОТПРАВЛЕН
  ЗАКРЫТ
}

Пользователь "1" *-- "1" Профиль
Пользователь "1" --> "0..*" Заказ : оформляет
Заказ "1" *-- "1..*" Позиция
Позиция "0..*" --> "1" Товар
Заказ --> Статус
@enduml
